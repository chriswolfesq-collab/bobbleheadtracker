# Copy this file to .env.local (already gitignored) and fill in real values
# from your Supabase project's Settings > API page.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Shared secret guarding /api/revalidate. Must match the x-revalidate-secret
# header sent by the Supabase trigger in supabase/revalidate_trigger.sql. Set
# the real value in the Vercel project (not needed for local dev).
REVALIDATE_SECRET=any-long-random-string

# Service-role key used ONLY by the two Vercel Cron routes
# (/api/dead-image-sweep, /api/giveaway-scrape), which run with no signed-in
# user and must bypass RLS. Server-side only — note the deliberate absence of a
# NEXT_PUBLIC_ prefix so it can never be inlined into a client bundle. Set the
# real value in the Vercel project; only needed locally to exercise those routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret guarding the two cron routes. Vercel Cron sends it automatically
# as `Authorization: Bearer $CRON_SECRET`; the same header lets an admin trigger
# a run by hand. Set the real value in the Vercel project.
CRON_SECRET=any-long-random-string
